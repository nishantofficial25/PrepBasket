MONGODB_URI=
ADMIN_EMAIL=
# generate: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"  (escape $ as \$ in .env)
ADMIN_PASSWORD_HASH=
AUTH_SECRET=   # 32+ random chars
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
CONTACT_EMAIL=
# Where uploaded product images (WebP) are stored. Default: ./public/uploads
# In production point this at a persistent disk / Docker volume, e.g. /data/uploads
UPLOAD_DIR=
# Optional: Upstash Redis for store-click counts shown in /admin
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional footer social icons (an icon shows only if its URL is set)
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_LINKEDIN_URL=
